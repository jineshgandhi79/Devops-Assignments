{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "title": "DevOps Enterprise Portal - SRE Golden Signals",
  "tags": ["devops", "k8s", "production"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status_code)",
          "legendFormat": "HTTP {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency (p99 Duration)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod Memory Usage",
      "type": "gauge",
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container=\"devops-portal\"} / (1024 * 1024)",
          "legendFormat": "{{pod}} (MB)"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
